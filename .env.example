# Optional overrides — the site works without a .env file.
# Copy to .env (or add in Vercel → Project → Settings → Environment Variables,
# then redeploy). See src/lib/form-endpoint.ts.
#
# The two forms already use the Web3Forms access keys in src/data/site.ts
# (SITE.forms). Set these only to swap a key without editing the code:

# Contact page + solution pages enquiry form.
PUBLIC_WEB3FORMS_ENQUIRY_KEY=

# Josoorkom sign-up pop-up.
PUBLIC_WEB3FORMS_JOSOORKOM_KEY=

# Send BOTH forms to another endpoint that accepts a FormData POST instead of
# Web3Forms (Formspree, Getform, a serverless function…).
PUBLIC_FORM_ENDPOINT=
