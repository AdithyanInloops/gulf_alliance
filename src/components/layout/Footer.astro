---
/** Common footer — copy from content doc §13. */
import Icon from '@/components/ui/Icon.astro';
import Logo from '@/components/ui/Logo.astro';
import { getContent } from '@/data';
import { mapsUrl, SITE } from '@/data/site';

const { brand, nav, footer, solutions, ui, R } = getContent(Astro.url);
---

<footer class="footer" data-tone="dark">
  <div class="footer__glow" aria-hidden="true"></div>
  <div class="container">
    <div class="footer__grid">
      <div class="footer__brand">
        <Logo variant="footer" />
        <p class="footer__tagline">{brand.tagline}</p>
        <p class="footer__desc">{brand.description}</p>
        {
          SITE.social.length > 0 && (
            <div class="footer__follow">
              <p class="footer__follow-title" id="footer-follow">{ui.followUs}</p>
              <ul class="footer__social" aria-labelledby="footer-follow">
                {SITE.social.map((s) => (
                  <li>
                    {s.href ? (
                      <a href={s.href} target="_blank" rel="noopener noreferrer" aria-label={`${s.label} ${ui.newTab}`} title={s.label}>
                        <Icon name={s.icon} size={19} />
                      </a>
                    ) : (
                      <span role="img" aria-label={s.label} title={s.label}>
                        <Icon name={s.icon} size={19} />
                      </span>
                    )}
                  </li>
                ))}
              </ul>
            </div>
          )
        }
      </div>

      <nav aria-labelledby="footer-quick">
        <h2 id="footer-quick" class="footer__heading">{footer.quickLinksTitle}</h2>
        <ul class="footer__links">
          {nav.map((l) => <li><a href={l.href}>{l.label}</a></li>)}
        </ul>
      </nav>

      <nav aria-labelledby="footer-solutions">
        <h2 id="footer-solutions" class="footer__heading">{footer.solutionsTitle}</h2>
        <ul class="footer__links">
          {
            solutions.map((s) => (
              <li>
                <a href={R.solution(s.slug)}>{s.name}</a>
              </li>
            ))
          }
        </ul>
      </nav>

      <div>
        <h2 class="footer__heading">{footer.contactTitle}</h2>
        <ul class="footer__contact">
          <li>
            <Icon name="map-pin" size={19} />
            <a href={mapsUrl} target="_blank" rel="noopener noreferrer">{brand.address}</a>
          </li>
          <li>
            <Icon name="phone" size={19} />
            <a href={SITE.contact.phoneHref} class="ltr">{SITE.contact.phoneDisplay}</a>
          </li>
          <li>
            <Icon name="mail" size={19} />
            <a href={SITE.contact.emailHref} class="ltr">{SITE.contact.email}</a>
          </li>
        </ul>
      </div>
    </div>

    <div class="footer__bottom">
      <p>{footer.copyright}</p>
      <ul class="footer__legal">
        {footer.legal.map((l) => <li><a href={l.href}>{l.label}</a></li>)}
      </ul>
    </div>
  </div>
</footer>

<style>
  .footer {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    padding-top: clamp(56px, 7vw, 88px);
    background: linear-gradient(180deg, var(--color-navy-900) 0%, var(--color-navy-950) 100%);
    color: var(--color-blue-300);
  }
  .footer__glow {
    position: absolute;
    z-index: -1;
    inset-inline-end: -10%;
    top: -40%;
    width: 50%;
    height: 90%;
    border-radius: 50%;
    background: radial-gradient(closest-side, rgb(47 93 154 / 0.5), transparent);
    filter: blur(40px);
  }
  .footer__grid {
    display: grid;
    grid-template-columns: minmax(0, 1.3fr) repeat(3, minmax(0, 1fr));
    gap: clamp(28px, 4vw, 56px);
    padding-bottom: clamp(48px, 6vw, 72px);
  }
  .footer__tagline { margin-top: 22px; font-family: var(--font-display); font-size: 1.05rem; font-weight: 600; line-height: 1.5; color: #fff; }
  .footer__desc { margin-top: 14px; max-width: 42ch; font-size: var(--fs-small); line-height: 1.7; color: var(--color-blue-400); }

  .footer__follow { margin-top: 26px; }
  .footer__follow-title { font-family: var(--font-display); font-size: var(--fs-small); font-weight: 700; color: #fff; }
  .footer__social { display: flex; flex-wrap: wrap; gap: 10px; margin: 12px 0 0; padding: 0; list-style: none; }
  .footer__social :is(a, span) {
    display: grid;
    place-items: center;
    width: 42px;
    height: 42px;
    border: 1px solid rgb(255 255 255 / 0.14);
    border-radius: 50%;
    background: rgb(255 255 255 / 0.06);
    color: #fff;
    transition: background-color 0.25s var(--ease), color 0.25s var(--ease), border-color 0.25s var(--ease), transform 0.25s var(--ease);
  }
  .footer__social a:hover { border-color: var(--color-gold-500); background: var(--color-gold-500); color: var(--color-navy-950); transform: translateY(-2px); }

  .footer__heading {
    margin: 4px 0 20px;
    font-family: var(--font-display);
    font-size: 1.05rem;
    font-weight: 700;
    color: #fff;
  }
  .footer__links { display: grid; gap: 12px; margin: 0; padding: 0; list-style: none; }
  .footer__links a { font-size: var(--fs-small); color: var(--color-blue-300); transition: color 0.2s; }
  .footer__links a:hover { color: #fff; }

  .footer__contact { display: grid; gap: 16px; margin: 0; padding: 0; list-style: none; }
  .footer__contact li { display: flex; gap: 12px; align-items: flex-start; font-size: var(--fs-small); line-height: 1.6; }
  .footer__contact :global(svg) { flex: none; margin-top: 2px; color: var(--color-gold-500); }
  .footer__contact a { color: var(--color-blue-300); transition: color 0.2s; }
  .footer__contact a:hover { color: #fff; }

  .footer__bottom {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 12px 24px;
    padding-block: 24px 32px;
    border-top: 1px solid rgb(255 255 255 / 0.1);
    font-size: var(--fs-xs);
    color: var(--color-blue-400);
  }
  .footer__legal { display: flex; gap: 20px; margin: 0; padding: 0; list-style: none; }
  .footer__legal a:hover { color: #fff; }

  @media (max-width: 1023px) {
    .footer__grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
  @media (max-width: 599px) {
    .footer__grid { grid-template-columns: minmax(0, 1fr); }
    /* Leave room for the WhatsApp button. */
    .footer__bottom { padding-bottom: 88px; }
  }
</style>
