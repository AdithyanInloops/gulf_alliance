---
/**
 * Floating WhatsApp button (bottom right): opens a chat with the company
 * number, with a short greeting prefilled in the page's language.
 */
import { getContent } from '@/data';
import { whatsappUrl } from '@/data/site';

const { ui } = getContent(Astro.url);
---

<a href={whatsappUrl(ui.whatsapp.message)} class="wa" target="_blank" rel="noopener noreferrer" aria-label={`${ui.whatsapp.label} ${ui.newTab}`}>
  <span class="wa__pulse" aria-hidden="true"></span>
  <svg class="wa__icon" viewBox="0 0 24 24" width="30" height="30" fill="currentColor" aria-hidden="true" focusable="false">
    <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 0 1-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 0 1-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 0 1 2.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0 0 12.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 0 0 5.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 0 0-3.48-8.413Z" />
  </svg>
  <span class="wa__label" aria-hidden="true">{ui.whatsapp.label}</span>
</a>

<style>
  .wa {
    position: fixed;
    right: max(18px, env(safe-area-inset-right));
    bottom: max(18px, env(safe-area-inset-bottom));
    z-index: 90;
    display: grid;
    place-items: center;
    width: 58px;
    height: 58px;
    border-radius: 50%;
    background: #25d366;
    color: #fff;
    box-shadow: 0 12px 28px -10px rgb(18 140 70 / 0.65), 0 2px 6px rgb(12 34 68 / 0.18);
    transition: transform 0.3s var(--ease), box-shadow 0.3s var(--ease);
    animation: wa-in 0.6s var(--ease) 0.8s backwards;
  }
  .wa:hover { transform: translateY(-3px) scale(1.04); box-shadow: 0 18px 34px -12px rgb(18 140 70 / 0.75), 0 2px 6px rgb(12 34 68 / 0.18); }
  .wa__icon { position: relative; z-index: 1; }

  .wa__pulse {
    position: absolute;
    inset: 0;
    border-radius: 50%;
    background: #25d366;
    animation: wa-pulse 2.6s var(--ease) infinite;
  }

  /* Label slides out to the left of the button on hover / focus. */
  .wa__label {
    position: absolute;
    right: calc(100% + 12px);
    top: 50%;
    padding: 8px 14px;
    border-radius: var(--radius-pill);
    background: #fff;
    box-shadow: var(--shadow-md);
    font-family: var(--font-display);
    font-size: var(--fs-xs);
    font-weight: 700;
    color: var(--color-navy-950);
    white-space: nowrap;
    opacity: 0;
    transform: translate(8px, -50%);
    pointer-events: none;
    transition: opacity 0.25s var(--ease), transform 0.3s var(--ease);
  }
  .wa:hover .wa__label,
  .wa:focus-visible .wa__label { opacity: 1; transform: translate(0, -50%); }

  @keyframes wa-pulse {
    0% { transform: scale(1); opacity: 0.55; }
    70%,
    100% { transform: scale(1.55); opacity: 0; }
  }
  @keyframes wa-in {
    from { opacity: 0; transform: translateY(16px) scale(0.8); }
  }
  @media (max-width: 599px) {
    .wa { width: 52px; height: 52px; }
    .wa__icon { width: 27px; height: 27px; }
  }
  @media (prefers-reduced-motion: reduce) {
    .wa__pulse { display: none; }
  }
</style>
