---
/**
 * Contact › Enquiry Form (first card) + Contact Information with the office
 * map (second card).
 */
import Eyebrow from '@/components/ui/Eyebrow.astro';
import Icon from '@/components/ui/Icon.astro';
import IconTile from '@/components/ui/IconTile.astro';
import Section from '@/components/ui/Section.astro';
import { getContent } from '@/data';
import { mapEmbedUrl, mapsUrl } from '@/data/site';
import EnquiryForm from '@/components/sections/shared/EnquiryForm.astro';

const { contact, brand, ui, lang } = getContent(Astro.url);
const { info, form } = contact;
const mapEmbed = mapEmbedUrl(lang);
const iconFor = { phone: 'phone', email: 'mail', address: 'building-2' } as const;
// Address first, then phone and email (as designed).
const rows = ['address', 'phone', 'email'].map((key) => info.items.find((i) => i.key === key)!);
---

<Section tone="page" labelledby="enquiry-title">
  <div class="cm">
    <div class="cm__form" id="enquiry" data-reveal>
      <Eyebrow>{form.eyebrow}</Eyebrow>
      <h2 id="enquiry-title" class="cm__title">{form.title}</h2>
      <p class="cm__text">{form.text}</p>
      <EnquiryForm icons />
    </div>

    <aside class="cm__info" aria-labelledby="contact-info-title" data-reveal>
      <Eyebrow>{info.eyebrow}</Eyebrow>
      <h2 id="contact-info-title" class="cm__title cm__title--sm">{info.title}</h2>
      <p class="cm__text">{info.text}</p>

      <ul class="cm__rows">
        {
          rows.map((item) => (
            <li>
              <IconTile icon={iconFor[item.key]} variant="light-orange" />
              <div>
                <p class="cm__row-label">{item.label}</p>
                <a
                  href={item.href}
                  class:list={['cm__row-value', { 'is-gold': item.key === 'phone' }]}
                  target={item.href.startsWith('http') ? '_blank' : undefined}
                  rel={item.href.startsWith('http') ? 'noopener noreferrer' : undefined}
                >
                  {item.key === 'address' ? item.value : <span class="ltr">{item.value}</span>}
                </a>
              </div>
            </li>
          ))
        }
      </ul>

      <div class="cm__map">
        <iframe src={mapEmbed} title={`${brand.name} — ${brand.address}`} loading="lazy" referrerpolicy="no-referrer-when-downgrade"></iframe>
        <div class="cm__map-bar">
          <span class="cm__map-place">{brand.city}</span>
          <a href={mapsUrl} target="_blank" rel="noopener noreferrer" class="cm__map-btn">
            {ui.openMaps} <Icon name="square-arrow-out-up-right" size={16} strokeWidth={2} class="icon-dir" />
            <span class="visually-hidden">{ui.newTab}</span>
          </a>
        </div>
      </div>
    </aside>
  </div>
</Section>

<style>
  .cm {
    display: grid;
    grid-template-columns: minmax(0, 1.35fr) minmax(0, 1fr);
    align-items: start;
    gap: 24px;
  }
  .cm__form,
  .cm__info {
    padding: clamp(24px, 3.5vw, 40px);
    border: 1px solid var(--border);
    border-radius: var(--radius-xl);
    background: #fff;
    box-shadow: var(--shadow-md);
    scroll-margin-top: calc(var(--header-h) + 20px);
  }
  .cm__title { font-size: clamp(1.7rem, 1.3rem + 1.2vw, 2.2rem); color: var(--color-navy-950); }
  .cm__title--sm { font-size: clamp(1.45rem, 1.2rem + 0.8vw, 1.75rem); }
  .cm__text { margin: 12px 0 26px; font-size: var(--fs-body); line-height: 1.6; color: var(--color-ink); }

  .cm__rows { display: grid; gap: 20px; margin: 0 0 24px; padding: 0; list-style: none; }
  .cm__rows li { display: flex; align-items: flex-start; gap: 14px; }
  .cm__row-label { font-family: var(--font-display); font-size: var(--fs-small); font-weight: 700; color: var(--color-navy-950); }
  .cm__row-value { display: block; margin-top: 2px; font-size: var(--fs-small); line-height: 1.5; color: var(--color-ink); overflow-wrap: anywhere; }
  .cm__row-value.is-gold { color: var(--color-orange-600); font-weight: 600; }
  .cm__row-value:hover { color: var(--color-navy-950); }

  .cm__map { position: relative; overflow: hidden; height: 260px; border-radius: var(--radius-lg); background: var(--color-blue-100); }
  .cm__map iframe { position: absolute; inset: 0; width: 100%; height: 100%; border: 0; }
  .cm__map-bar {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    padding: 28px 14px 12px;
    background: linear-gradient(180deg, transparent, rgb(12 34 68 / 0.85));
    pointer-events: none;
  }
  .cm__map-place {
    font-family: var(--font-display);
    font-size: var(--fs-xs);
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-gold-500);
  }
  .cm__map-btn {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 7px 14px;
    border-radius: var(--radius-pill);
    background: #fff;
    font-family: var(--font-display);
    font-size: var(--fs-xs);
    font-weight: 700;
    color: var(--color-navy-950);
    pointer-events: auto;
  }

  @media (max-width: 999px) {
    .cm { grid-template-columns: minmax(0, 1fr); }
  }
</style>
