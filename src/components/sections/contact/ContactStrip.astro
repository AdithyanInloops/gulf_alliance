---
/** Contact hero › three-column contact strip (Phone, Email, Address). */
import IconTile from '@/components/ui/IconTile.astro';
import { getContent } from '@/data';

const { contact } = getContent(Astro.url);
const iconFor = { phone: 'phone-call', email: 'mail', address: 'building-2' } as const;
---

<ul class="strip">
  {
    contact.info.items.map((item) => (
      <li>
        <a
          href={item.href}
          class="strip__item"
          target={item.href.startsWith('http') ? '_blank' : undefined}
          rel={item.href.startsWith('http') ? 'noopener noreferrer' : undefined}
        >
          <IconTile icon={iconFor[item.key]} variant="gold" />
          <span>
            <span class="strip__label">{item.label}</span>
            <span class="strip__value">{item.key === 'address' ? item.value : <span class="ltr">{item.value}</span>}</span>
          </span>
        </a>
      </li>
    ))
  }
</ul>

<style>
  .strip {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 14px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .strip__item {
    display: flex;
    align-items: center;
    gap: 16px;
    height: 100%;
    padding: 18px 20px;
    border: 1px solid rgb(255 255 255 / 0.14);
    border-radius: var(--radius-lg);
    background: rgb(255 255 255 / 0.07);
    backdrop-filter: blur(8px);
    transition: background-color 0.25s var(--ease), border-color 0.25s var(--ease), transform 0.25s var(--ease);
  }
  .strip__item:hover { background: rgb(255 255 255 / 0.12); border-color: rgb(248 184 77 / 0.5); transform: translateY(-2px); }
  .strip__label {
    display: block;
    font-family: var(--font-display);
    font-size: var(--fs-2xs);
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-blue-400);
  }
  .strip__value { display: block; margin-top: 2px; font-family: var(--font-display); font-size: 0.98rem; font-weight: 600; line-height: 1.45; color: #fff; }
  .strip__item:hover .strip__value { color: var(--color-gold-400); }

  @media (max-width: 899px) {
    .strip { grid-template-columns: minmax(0, 1fr); }
  }
</style>
