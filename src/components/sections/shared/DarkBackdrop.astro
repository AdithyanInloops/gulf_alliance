---
/**
 * Background for navy sections (heroes, CTA bands): a soft lighter-blue glow
 * on one side, a warm gold glow on the other, faint large circle arcs and,
 * optionally, a fine dot grid. Place inside a positioned, isolated parent.
 */
interface Props {
  /** Fine dot grid (heroes). */
  grid?: boolean;
  arcs?: boolean;
}
const { grid = false, arcs = true } = Astro.props;
---

<div class="db" aria-hidden="true">
  <div class="db__glow db__glow--start"></div>
  <div class="db__glow db__glow--end"></div>
  {arcs && <div class="db__arc db__arc--a" />}
  {arcs && <div class="db__arc db__arc--b" />}
  {grid && <div class="db__grid" />}
</div>

<style>
  .db { position: absolute; inset: 0; z-index: -1; overflow: hidden; pointer-events: none; }
  .db__glow { position: absolute; border-radius: 50%; filter: blur(60px); }
  .db__glow--start {
    inset-inline-start: -14%;
    top: 0;
    width: 55%;
    height: 100%;
    background: radial-gradient(closest-side, rgb(47 93 154 / 0.75), transparent);
  }
  .db__glow--end {
    inset-inline-end: -10%;
    top: -30%;
    width: 42%;
    height: 110%;
    background: radial-gradient(closest-side, rgb(248 184 77 / 0.16), transparent);
  }
  .db__arc {
    position: absolute;
    border-radius: 50%;
    border: 1px solid rgb(255 255 255 / 0.08);
  }
  .db__arc--a { inset-inline-end: -8%; top: -32%; width: 46vw; height: 46vw; }
  .db__arc--b { inset-inline-start: 18%; bottom: -60%; width: 40vw; height: 40vw; }
  .db__grid {
    position: absolute;
    inset: 0;
    background-image: radial-gradient(rgb(255 255 255 / 0.12) 1px, transparent 1px);
    background-size: 26px 26px;
    mask-image: linear-gradient(180deg, transparent, #000 30%, #000 70%, transparent);
  }
</style>
