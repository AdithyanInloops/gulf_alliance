---
/**
 * Navy page hero (Solutions, Contact, legal pages): small dot pill, h1 with
 * an optional gold highlight, intro, gold button. Extra content (e.g. the
 * Contact info strip) goes in the default slot.
 */
import Button from '@/components/ui/Button.astro';
import type { Cta } from '@/data/types';
import DarkBackdrop from './DarkBackdrop.astro';

interface Props {
  title: string;
  /** Trailing words of the title to show in gold. */
  highlight?: string;
  text: string;
  cta?: Cta;
}

const { title, highlight, text, cta } = Astro.props;
const hasHighlight = highlight && title.endsWith(highlight);
const lead = hasHighlight ? title.slice(0, title.length - highlight.length) : title;
---

<section class="dh" data-tone="dark" aria-labelledby="page-title">
  <DarkBackdrop grid />
  <div class="container">
    <span class="dh__pill dh__anim" aria-hidden="true"><span></span></span>
    <h1 id="page-title" class="dh__title dh__anim">
      {lead}{hasHighlight && <span class="dh__accent">{highlight}</span>}
    </h1>
    <p class="dh__text dh__anim">{text}</p>
    {cta && <div class="dh__actions dh__anim"><Button href={cta.href} variant="gold" size="lg" icon={cta.href.startsWith('#') ? 'arrow-down' : 'arrow-right'}>{cta.label}</Button></div>}
    {Astro.slots.has('default') && <div class="dh__extra dh__anim"><slot /></div>}
  </div>
</section>

<style>
  .dh {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    padding: calc(var(--header-h) + clamp(48px, 6vw, 88px)) 0 clamp(56px, 6vw, 88px);
    background: linear-gradient(160deg, var(--color-navy-800) 0%, var(--color-navy-900) 55%, var(--color-navy-950) 100%);
  }
  .dh__pill { display: inline-flex; align-items: center; width: 40px; height: 16px; padding-inline-start: 12px; border-radius: 99px; background: rgb(255 255 255 / 0.12); }
  .dh__pill span { width: 7px; height: 7px; border-radius: 50%; background: var(--color-gold-500); }
  .dh__title { max-width: 900px; margin-top: 24px; font-size: var(--fs-display); line-height: 1.06; letter-spacing: -0.04em; color: #fff; }
  .dh__accent {
    background: linear-gradient(90deg, var(--color-gold-500), var(--color-gold-300));
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }
  .dh__text { max-width: 64ch; margin-top: 22px; font-size: var(--fs-lead); line-height: 1.7; color: var(--color-blue-300); }
  .dh__actions { margin-top: 32px; }
  .dh__extra { margin-top: 44px; }

  .dh :global(.dh__anim) { animation: dh-in 0.9s var(--ease) backwards; }
  .dh__title { animation-delay: 0.06s; }
  .dh__text { animation-delay: 0.12s; }
  .dh__actions,
  .dh__extra { animation-delay: 0.18s; }
  @keyframes dh-in {
    from { opacity: 0; transform: translateY(16px); }
  }
</style>
