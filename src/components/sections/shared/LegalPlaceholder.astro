---
/**
 * Body for the legal pages until the client supplies the final text.
 * TODO(client): replace with the approved Privacy Policy / Terms copy and
 * remove `noindex` from the page.
 */
import Button from '@/components/ui/Button.astro';
import Section from '@/components/ui/Section.astro';
import { fill, getContent } from '@/data';
import { SITE } from '@/data/site';

interface Props {
  title: string;
}

const { title } = Astro.props;
const { ui, R } = getContent(Astro.url);
---

<Section tone="page">
  <div class="legal">
    <p>
      {fill(ui.legal.pending, { title })}
      <a href={SITE.contact.emailHref} class="ltr">{SITE.contact.email}</a>.
    </p>
    <Button href={R.contact} variant="navy">{ui.contactUs}</Button>
  </div>
</Section>

<style>
  .legal { max-width: 720px; }
  .legal p { margin-bottom: 28px; font-size: var(--fs-lead); line-height: 1.7; color: var(--color-ink); }
  .legal a { color: var(--color-orange-600); text-decoration: underline; text-underline-offset: 3px; }
</style>
