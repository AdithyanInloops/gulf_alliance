---
/**
 * Solutions › Explore Our Areas of Expertise: heading + text on one side, a
 * grid of cards on the other — one per solution area, each jumping to its
 * block below.
 */
import Icon from '@/components/ui/Icon.astro';
import IconTile from '@/components/ui/IconTile.astro';
import Section from '@/components/ui/Section.astro';
import { getContent } from '@/data';

const { solutionsPage, solutions } = getContent(Astro.url);
const { intro } = solutionsPage;
---

<Section id="areas" tone="page" labelledby="areas-title">
  <div class="si">
    <div class="si__copy" data-reveal>
      <h2 id="areas-title">{intro.title}</h2>
      <p class="si__text">{intro.text}</p>
    </div>
    <ul class="si__grid" data-reveal-group="up">
      {
        solutions.map((s, i) => (
          <li>
            <a href={`#area-${s.slug}`} class="si__card">
              <IconTile icon={s.icon} size="sm" />
              <span class="si__num">{String(i + 1).padStart(2, '0')}</span>
              <span class="si__name">{s.name}</span>
              <Icon name="arrow-down" size={16} strokeWidth={2.2} class="si__arrow" />
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</Section>

<style>
  .si {
    display: grid;
    grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr);
    align-items: center;
    gap: clamp(32px, 5vw, 72px);
  }
  .si__copy h2 { font-size: clamp(1.9rem, 1.35rem + 1.7vw, 2.75rem); color: var(--color-navy-950); }
  .si__text { margin-top: 18px; font-size: var(--fs-lead); line-height: 1.75; color: var(--color-ink); }
  .si__grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 14px; margin: 0; padding: 0; list-style: none; }
  .si__grid li:last-child { grid-column: span 2; }
  .si__card {
    display: grid;
    grid-template-columns: auto 1fr auto;
    grid-template-rows: auto auto;
    column-gap: 14px;
    align-items: center;
    padding: 16px 18px;
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
    background: #fff;
    box-shadow: var(--shadow-xs);
    transition: box-shadow 0.25s var(--ease), transform 0.25s var(--ease), border-color 0.25s var(--ease);
  }
  .si__card:hover { transform: translateY(-2px); border-color: var(--color-blue-200); box-shadow: var(--shadow-md); }
  .si__card :global(.tile) { grid-row: span 2; }
  .si__num { font-family: var(--font-display); font-size: var(--fs-2xs); font-weight: 700; color: var(--color-orange-600); }
  .si__name { grid-column: 2; font-family: var(--font-display); font-size: 1rem; font-weight: 700; color: var(--color-navy-950); }
  .si__card :global(.si__arrow) { grid-column: 3; grid-row: 1 / span 2; color: var(--color-blue-400); transition: transform 0.25s var(--ease), color 0.25s; }
  .si__card:hover :global(.si__arrow) { color: var(--color-orange-600); transform: translateY(2px); }

  @media (max-width: 899px) {
    .si { grid-template-columns: minmax(0, 1fr); }
  }
  @media (max-width: 499px) {
    .si__grid { grid-template-columns: minmax(0, 1fr); }
    .si__grid li:last-child { grid-column: auto; }
  }
</style>
