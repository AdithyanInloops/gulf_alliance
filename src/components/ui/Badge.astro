---
/** Small rectangular tag (serif bold), e.g. "01" on cards. */
interface Props {
  tone?: 'blue' | 'orange' | 'gold' | 'navy';
  class?: string;
}
const { tone = 'blue', class: className } = Astro.props;
---

<span class:list={['badge', `badge--${tone}`, className]}><slot /></span>

<style>
  .badge {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 4px 10px;
    border-radius: var(--radius-xs);
    font-family: var(--font-display);
    font-size: var(--fs-2xs);
    font-weight: 700;
    letter-spacing: 0.04em;
    line-height: 1.3;
    text-transform: uppercase;
    white-space: nowrap;
  }
  .badge--blue { background: var(--color-blue-200); color: var(--color-navy-950); }
  .badge--orange { background: var(--color-orange-100); color: var(--color-navy-950); }
  .badge--gold { background: var(--color-gold-500); color: var(--color-navy-950); }
  .badge--navy { background: var(--color-navy-700); color: var(--color-gold-500); }
</style>
