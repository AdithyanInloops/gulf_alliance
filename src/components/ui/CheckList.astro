---
/** List with orange check-circle bullets (as designed). */
import Icon from './Icon.astro';

interface Props {
  items: string[];
  columns?: 1 | 2;
  /** Bold serif labels instead of body text. */
  strong?: boolean;
  class?: string;
}

const { items, columns = 1, strong = false, class: className } = Astro.props;
---

<ul class:list={['checks', `checks--cols-${columns}`, { 'checks--strong': strong }, className]}>
  {
    items.map((item) => (
      <li>
        <Icon name="circle-check" size={18} strokeWidth={2} class="checks__icon" />
        <span>{item}</span>
      </li>
    ))
  }
</ul>

<style>
  .checks {
    display: grid;
    gap: 10px 20px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .checks--cols-2 { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  .checks li {
    display: flex;
    align-items: flex-start;
    gap: 9px;
    font-size: var(--fs-small);
    line-height: 1.45;
    color: var(--body);
  }
  .checks--strong li {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 1rem;
    color: var(--text);
  }
  .checks :global(.checks__icon) { flex: none; margin-top: 1px; color: var(--color-orange-600); }
  :global([data-tone='dark']) .checks :global(.checks__icon) { color: var(--color-gold-500); }

  @media (max-width: 599px) {
    .checks--cols-2 { grid-template-columns: minmax(0, 1fr); }
  }
</style>
