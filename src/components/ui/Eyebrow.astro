---
/**
 * Small uppercase label above section titles (serif bold caps, as designed).
 *   variant="text"  orange caps (gold on navy)
 *   variant="pill"  rounded light-blue pill with a dot
 *   variant="line"  short gold rule before the text
 *   variant="icon"  light-blue pill with an icon (pass `icon`)
 */
import Icon from './Icon.astro';
import type { IconName } from './icons';

interface Props {
  variant?: 'text' | 'pill' | 'line' | 'icon';
  icon?: IconName;
  class?: string;
  [attr: `data-${string}`]: string | undefined;
}

const { variant = 'text', icon, class: className, ...rest } = Astro.props;
---

<p class:list={['eyebrow', `eyebrow--${variant}`, className]} {...rest}>
  {(variant === 'pill') && <span class="eyebrow__dot" aria-hidden="true" />}
  {variant === 'line' && <span class="eyebrow__line" aria-hidden="true" />}
  {variant === 'icon' && icon && <Icon name={icon} size={18} strokeWidth={1.8} class="eyebrow__icon" />}
  <span><slot /></span>
</p>

<style>
  .eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    margin: 0 0 14px;
    font-family: var(--font-display);
    font-size: var(--fs-2xs);
    font-weight: 700;
    letter-spacing: 0.12em;
    line-height: 1.3;
    text-transform: uppercase;
    color: var(--color-orange-600);
  }
  :global([data-tone='dark']) .eyebrow { color: var(--color-gold-500); }

  .eyebrow--pill,
  .eyebrow--icon {
    padding: 6px 12px;
    border-radius: var(--radius-pill);
    background: var(--color-blue-200);
  }
  .eyebrow--icon { color: var(--color-navy-950); border-radius: var(--radius-sm); padding: 6px 12px 6px 10px; }
  .eyebrow--icon :global(.eyebrow__icon) { color: var(--color-orange-600); }
  :global([data-tone='dark']) .eyebrow--pill { background: var(--color-navy-700); }

  .eyebrow__dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--color-orange-600);
  }
  :global([data-tone='dark']) .eyebrow__dot { background: var(--color-gold-500); }

  .eyebrow__line {
    width: 26px;
    height: 2px;
    border-radius: 2px;
    background: var(--color-gold-500);
  }
</style>
