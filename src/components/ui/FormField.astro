---
/**
 * Labelled form control: light-blue fill, bold label, "*Mandatory" marker,
 * optional icon inside the field. Email and phone fields stay left-to-right on
 * Arabic pages. The error element id is `${id}-error`, filled by
 * scripts/forms.ts.
 * `countryCode` (phone fields): a dialling-code chip ("+966 ▾") in front of the
 * number; it is a native <select> of every country (lib/countries.ts), so phones
 * show their own picker. scripts/forms.ts keeps the chip in step and joins code
 * and number on submit (fullPhone).
 */
import { getContent } from '@/data';
import { countryCodes, DEFAULT_COUNTRY } from '@/lib/countries';
import Icon from './Icon.astro';
import type { IconName } from './icons';

interface Option {
  value: string;
  label: string;
}

interface Props {
  id: string;
  name: string;
  label: string;
  type?: 'text' | 'email' | 'tel' | 'select' | 'textarea';
  required?: boolean;
  autocomplete?: string;
  options?: Option[];
  /** Text of the empty first option for selects. */
  placeholder?: string;
  rows?: number;
  maxlength?: number;
  inputmode?: 'text' | 'email' | 'tel' | 'numeric';
  icon?: IconName;
  /** Phone fields: country dialling-code menu in front of the number. */
  countryCode?: boolean;
  autofocus?: boolean;
  class?: string;
}

const {
  id,
  name,
  label,
  type = 'text',
  required = false,
  autocomplete,
  options = [],
  placeholder,
  rows = 4,
  maxlength,
  inputmode,
  icon,
  countryCode = false,
  autofocus,
  class: className,
} = Astro.props;

const { ui, lang, dir } = getContent(Astro.url);
const errorId = `${id}-error`;
const ltr = type === 'email' || type === 'tel';
const countries = countryCode ? countryCodes(lang) : null;
const defaultDial = countries?.first.find((c) => c.iso === DEFAULT_COUNTRY)?.dial;
---

<div class:list={['field', `field--${type}`, { 'field--icon': icon, 'field--cc': countryCode }, className]} data-field>
  <div class="field__head">
    <label for={id} class="field__label">{label}</label>
    {required && <span class="field__req">{ui.form.mandatory}</span>}
  </div>

  <div class="field__box" dir={ltr ? 'ltr' : undefined}>
    {
      countries && (
        <span class="field__cc">
          <span class="field__cc-code" aria-hidden="true" data-cc-code>+{defaultDial}</span>
          <Icon name="chevron-down" size={14} strokeWidth={2.4} class="field__cc-icon" />
          <select class="field__cc-select" aria-label={ui.form.countryCode} dir={dir} data-cc>
            {countries.first.map((c) => (
              <option value={c.iso} data-dial={c.dial} selected={c.iso === DEFAULT_COUNTRY}>
                {c.label}
              </option>
            ))}
            <option disabled>──────────</option>
            {countries.all.map((c) => (
              <option value={c.iso} data-dial={c.dial}>
                {c.label}
              </option>
            ))}
          </select>
        </span>
      )
    }
    {
      type === 'textarea' ? (
        <textarea id={id} name={name} rows={rows} required={required} maxlength={maxlength} aria-describedby={errorId} class="field__control" />
      ) : type === 'select' ? (
        <select id={id} name={name} required={required} aria-describedby={errorId} class="field__control">
          <option value="">{placeholder ?? label}</option>
          {options.map((o) => (
            <option value={o.value}>{o.label}</option>
          ))}
        </select>
      ) : (
        <input
          id={id}
          name={name}
          type={type}
          required={required}
          autocomplete={countryCode ? 'tel-national' : autocomplete}
          inputmode={inputmode}
          maxlength={maxlength}
          aria-describedby={errorId}
          autofocus={autofocus}
          class="field__control"
        />
      )
    }
    {type === 'select' && <Icon name="chevron-down" size={18} class="field__icon" />}
    {icon && type !== 'select' && <Icon name={icon} size={19} class="field__icon" />}
  </div>

  <p class="field__error" id={errorId} data-error aria-live="polite"></p>
</div>

<style>
  .field { display: flex; flex-direction: column; gap: 8px; }
  .field__head { display: flex; align-items: baseline; justify-content: space-between; gap: 10px; }
  .field__label {
    font-family: var(--font-display);
    font-size: var(--fs-small);
    font-weight: 700;
    color: var(--color-navy-950);
  }
  .field__req {
    font-family: var(--font-display);
    font-size: var(--fs-2xs);
    font-weight: 600;
    color: var(--color-orange-600);
  }

  .field__box { position: relative; display: flex; }
  .field__control {
    width: 100%;
    min-height: 50px;
    padding: 12px 16px;
    border: 1.5px solid var(--color-blue-200);
    border-radius: var(--radius-sm);
    background: var(--color-blue-50);
    color: var(--color-navy-950);
    font: inherit;
    font-size: 1rem;
    line-height: 1.5;
    transition: border-color 0.2s var(--ease), background-color 0.2s var(--ease), box-shadow 0.2s var(--ease);
  }
  .field__control:hover { border-color: var(--color-blue-400); }
  .field__control:focus {
    outline: none;
    border-color: var(--color-navy-700);
    background: #fff;
    box-shadow: 0 0 0 4px rgb(34 77 136 / 0.14);
  }
  textarea.field__control { min-height: 128px; resize: vertical; }
  select.field__control { appearance: none; padding-inline-end: 46px; cursor: pointer; }
  .field--icon .field__control { padding-inline-end: 46px; }

  .field__box :global(.field__icon) {
    position: absolute;
    inset-inline-end: 15px;
    top: 50%;
    translate: 0 -50%;
    color: #6b7383;
    pointer-events: none;
  }

  /* Dialling-code chip: shows "+966 ▾"; the invisible native <select> on top
     of it opens the country list. */
  .field--cc .field__control { padding-inline-start: 102px; }
  .field__cc {
    position: absolute;
    inset-block: 1.5px;
    inset-inline-start: 1.5px;
    z-index: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 6px;
    width: 88px;
    border-start-start-radius: calc(var(--radius-sm) - 1.5px);
    border-end-start-radius: calc(var(--radius-sm) - 1.5px);
    background: var(--color-blue-150);
    font-family: var(--font-display);
    font-size: var(--fs-xs);
    font-weight: 700;
    color: var(--color-navy-950);
    transition: background-color 0.2s var(--ease);
  }
  .field__cc:hover { background: var(--color-blue-200); }
  .field__cc :global(.field__cc-icon) { flex: none; color: #6b7383; }
  .field__cc-select {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    opacity: 0;
    border: 0;
    font-size: 16px; /* no zoom-in on iPhone when it opens */
    cursor: pointer;
  }
  .field__cc:has(.field__cc-select:focus-visible) { outline: 2.5px solid var(--color-orange-600); outline-offset: 2px; }

  .field__error { margin: 0; font-size: var(--fs-xs); font-weight: 600; color: #be123c; }
  .field__error:empty { display: none; }
  .field:has([aria-invalid='true']) .field__control { border-color: #e11d48; background: #fff; }
</style>
