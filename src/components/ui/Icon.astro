---
/**
 * Inline SVG icon from the registry in ./icons.ts.
 * Decorative by default (aria-hidden); pass `label` to expose it to screen readers.
 */
import { ICONS, type IconName } from './icons';

interface Props {
  name: IconName;
  size?: number | string;
  strokeWidth?: number;
  label?: string;
  class?: string;
  [attr: `data-${string}`]: string | undefined;
}

const { name, size = 20, strokeWidth = 1.75, label, class: className, ...rest } = Astro.props;
const body = ICONS[name];
---

<svg
  {...rest}
  xmlns="http://www.w3.org/2000/svg"
  viewBox="0 0 24 24"
  width={size}
  height={size}
  fill="none"
  stroke="currentColor"
  stroke-width={strokeWidth}
  stroke-linecap="round"
  stroke-linejoin="round"
  class:list={['icon', className]}
  role={label ? 'img' : undefined}
  aria-label={label}
  aria-hidden={label ? undefined : 'true'}
  focusable="false"
  set:html={body}
/>
