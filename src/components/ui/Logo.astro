---
/**
 * Company logo (client artwork in src/assets/brand).
 *   variant="header"  the horizontal artwork with the name enlarged (logo-header.png)
 *   variant="footer"  the light stacked artwork (white name, large) for navy backgrounds
 *   variant="stacked" / "horizontal"  the artwork alone, any height
 * `swap` also renders the light artwork on top, hidden until the parent shows
 * it (the header does while the navy mobile menu is open).
 * Images are optimised by Astro to WebP at 1×/2×/3× density, at full quality
 * so the small lettering stays crisp.
 */
import { Image } from 'astro:assets';
import logoHeader from '@/assets/brand/logo-header.png';
import logoHeaderLight from '@/assets/brand/logo-header-light.png';
import logoHorizontal from '@/assets/brand/logo-horizontal.png';
import logoStacked from '@/assets/brand/logo-stacked.png';
import logoStackedLight from '@/assets/brand/logo-stacked-light.png';
import { getContent } from '@/data';

interface Props {
  variant?: 'header' | 'footer' | 'stacked' | 'horizontal';
  /** Image height in px (artwork variants). */
  height?: number;
  href?: string | false;
  eager?: boolean;
  swap?: boolean;
  class?: string;
}

const { brand, ui, R } = getContent(Astro.url);
const { variant = 'header', height, href = R.home, eager = false, swap = false, class: className } = Astro.props;
const art = { header: logoHeader, footer: logoStackedLight, stacked: logoStacked, horizontal: logoHorizontal }[variant];
const h = height ?? { header: 72, footer: 170, stacked: 200, horizontal: 60 }[variant];
const w = Math.round((art.width / art.height) * h);
const Tag = href ? 'a' : 'span';
---

<Tag
  href={href || undefined}
  class:list={['logo', `logo--${variant}`, className]}
  aria-label={href ? `${brand.name} — ${ui.logoHome}` : undefined}
>
  <span class="logo__art">
    <Image src={art} alt={brand.name} width={w} height={h} densities={[1, 2, 3]} quality="max" loading={eager || variant === 'header' ? 'eager' : 'lazy'} class="logo__img" style={`height:${h}px`} />
    {swap && <Image src={logoHeaderLight} alt="" width={w} height={h} densities={[1, 2, 3]} quality="max" class="logo__img logo__img--light" style={`height:${h}px`} />}
  </span>
</Tag>

<style>
  .logo { display: inline-flex; align-items: center; gap: 14px; border-radius: 8px; color: inherit; }
  .logo__art { position: relative; flex: none; display: inline-flex; }
  .logo :global(.logo__img) { width: auto; max-width: none; height: auto; transition: opacity 0.35s var(--ease); }
  .logo :global(.logo__img--light) { position: absolute; inset-block-start: 0; inset-inline-start: 0; opacity: 0; }
</style>
