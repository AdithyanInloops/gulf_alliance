---
/**
 * Company logo (client artwork in src/assets/brand).
 *   variant="header"  the horizontal artwork alone (it carries the wordmark)
 *   variant="footer"  the artwork on a white chip (footer, on navy)
 *   variant="stacked" / "horizontal"  the artwork alone, any height
 * Images are optimised by Astro to WebP at 1×/2×/3× density.
 */
import { Image } from 'astro:assets';
import logoHorizontal from '@/assets/brand/logo-horizontal.png';
import logoStacked from '@/assets/brand/logo-stacked.png';
import { getContent } from '@/data';

interface Props {
  variant?: 'header' | 'footer' | 'stacked' | 'horizontal';
  /** Image height in px (artwork variants). */
  height?: number;
  href?: string | false;
  eager?: boolean;
  class?: string;
}

const { brand, ui, R } = getContent(Astro.url);
const { variant = 'header', height, href = R.home, eager = false, class: className } = Astro.props;
const art = variant === 'stacked' ? logoStacked : logoHorizontal;
const h = height ?? { header: 54, footer: 46, stacked: 200, horizontal: 60 }[variant];
const w = Math.round((art.width / art.height) * h);
const Tag = href ? 'a' : 'span';
---

<Tag
  href={href || undefined}
  class:list={['logo', `logo--${variant}`, className]}
  aria-label={href ? `${brand.name} — ${ui.logoHome}` : undefined}
>
  <span class="logo__art">
    <Image src={art} alt={brand.name} width={w} height={h} densities={[1, 2, 3]} loading={eager || variant === 'header' ? 'eager' : 'lazy'} class="logo__img" style={`height:${h}px`} />
  </span>
</Tag>

<style>
  .logo { display: inline-flex; align-items: center; gap: 14px; border-radius: 8px; color: inherit; }
  .logo__art { flex: none; display: inline-flex; }
  .logo :global(.logo__img) { width: auto; max-width: none; height: auto; }

  .logo--footer .logo__art { padding: 10px 14px; border-radius: 12px; background: #fff; }
</style>
