---
/**
 * Responsive photo (Astro <Image> → WebP at several widths).
 * `overlay` adds the design's navy gradient for captions/cards on top.
 * Extra content in the slot is layered over the image.
 * The crop keeps each photo's focal point (data/media.ts) in frame; pass
 * `position` to override it.
 *
 * Sharpness: `sizes` describes the frame's width, but when a wide photo
 * fills a narrower frame (object-fit: cover) it is drawn wider than the frame.
 * For a fixed `ratio` the sizes are scaled up automatically so the browser
 * downloads a file big enough not to be stretched; for `ratio="auto"` pass
 * `sizes` for the drawn width yourself.
 */
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';
import { focusOf } from '@/data/media';

interface Props {
  src: ImageMetadata;
  alt: string;
  /** CSS `sizes` hint for the frame, e.g. "(min-width: 900px) 600px, 100vw". */
  sizes?: string;
  ratio?: string;
  overlay?: 'none' | 'bottom' | 'navy' | 'full';
  radius?: 'md' | 'lg' | 'xl' | 'none';
  eager?: boolean;
  /** CSS object-position, e.g. "30% 50%". */
  position?: string;
  class?: string;
}

const {
  src,
  alt,
  sizes = '(min-width: 1000px) 620px, 100vw',
  ratio = '16 / 10',
  overlay = 'none',
  radius = 'lg',
  eager = false,
  position,
  class: className,
} = Astro.props;
const focus = position ?? focusOf(src);

// How much wider than the frame the photo is drawn when it covers it.
const frame = ratio.match(/^\s*([\d.]+)\s*\/\s*([\d.]+)\s*$/);
const overflow = frame ? Math.max(1, src.width / src.height / (Number(frame[1]) / Number(frame[2]))) : 1;
const drawnSizes =
  overflow > 1.02
    ? sizes
        .split(',')
        .map((part) => part.replace(/([\d.]+)(px|vw)\s*$/, (_, n: string, unit: string) => `${Math.ceil(Number(n) * overflow)}${unit}`))
        .join(',')
    : sizes;
const widths = [...new Set([480, 720, 960, 1200, 1600, src.width].filter((w) => w <= src.width))];
---

<div class:list={['photo', `photo--${overlay}`, `photo--r-${radius}`, className]} style={`aspect-ratio:${ratio}`}>
  <Image
    src={src}
    alt={alt}
    widths={widths}
    sizes={drawnSizes}
    quality={85}
    loading={eager ? 'eager' : 'lazy'}
    fetchpriority={eager ? 'high' : undefined}
    class="photo__img"
    style={focus ? `object-position:${focus}` : undefined}
  />
  {Astro.slots.has('default') && <div class="photo__layer"><slot /></div>}
</div>

<style>
  .photo { position: relative; overflow: hidden; background: var(--color-blue-200); }
  .photo--r-md { border-radius: var(--radius-md); }
  .photo--r-lg { border-radius: var(--radius-lg); }
  .photo--r-xl { border-radius: var(--radius-xl); }
  .photo :global(.photo__img) { width: 100%; height: 100%; object-fit: cover; }
  .photo::after { content: ''; position: absolute; inset: 0; pointer-events: none; }
  .photo--bottom::after { background: linear-gradient(180deg, transparent 40%, rgb(12 34 68 / 0.82) 100%); }
  /* Navy duotone (About hero). */
  .photo--navy :global(.photo__img) { filter: grayscale(0.85) brightness(0.9) contrast(1.05); }
  .photo--navy::after { background: linear-gradient(180deg, rgb(15 45 84 / 0.45) 0%, rgb(7 22 43 / 0.75) 100%); }
  .photo--full::after { background: linear-gradient(180deg, rgb(7 22 43 / 0.5), rgb(7 22 43 / 0.72)); }
  .photo__layer { position: absolute; inset: 0; z-index: 1; }
</style>
