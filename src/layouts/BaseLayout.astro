---
/**
 * Page shell used by every page: <head> (SEO), skip link, header, <main>,
 * footer, the WhatsApp button, the Josoorkom dialog and the global motion
 * script. Language and direction come from the URL (/ar/… is Arabic, RTL).
 */
import '@fontsource-variable/plus-jakarta-sans';
import '@fontsource-variable/inter';
import '@fontsource/ibm-plex-sans-arabic/arabic-400.css';
import '@fontsource/ibm-plex-sans-arabic/arabic-500.css';
import '@fontsource/ibm-plex-sans-arabic/arabic-600.css';
import '@fontsource/ibm-plex-sans-arabic/arabic-700.css';
import '@/styles/global.css';
import BaseHead, { type Props as HeadProps } from '@/components/layout/BaseHead.astro';
import Footer from '@/components/layout/Footer.astro';
import Header from '@/components/layout/Header.astro';
import JosoorkomDialog from '@/components/layout/JosoorkomDialog.astro';
import WhatsAppButton from '@/components/layout/WhatsAppButton.astro';
import { getContent } from '@/data';

type Props = HeadProps;

const props = Astro.props;
const { lang, dir, ui } = getContent(Astro.url);
---

<!doctype html>
<html lang={lang} dir={dir}>
  <head>
    <BaseHead {...props} />
    <!-- Lets CSS hide scroll-revealed parts only when JS will reveal them. -->
    <script is:inline>document.documentElement.classList.add('js');</script>
  </head>
  <body>
    <a class="skip-link" href="#main">{ui.skipLink}</a>
    <div class="scroll-progress" data-progress aria-hidden="true"></div>

    <Header />

    <main id="main" tabindex="-1">
      <slot />
    </main>

    <Footer />
    <WhatsAppButton />
    <JosoorkomDialog />

    <script>
      import '@/scripts/main';
    </script>
  </body>
</html>
