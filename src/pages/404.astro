---
/** 404 — not found. Served for any missing URL, so it shows both languages. */
import BaseLayout from '@/layouts/BaseLayout.astro';
import Button from '@/components/ui/Button.astro';
import DarkBackdrop from '@/components/sections/shared/DarkBackdrop.astro';
import { contentFor } from '@/data';

const en = contentFor('en');
const ar = contentFor('ar');
const t = en.ui.notFound;
---

<BaseLayout title={t.seoTitle} description={t.seoDescription} noindex>
  <section class="nf" data-tone="dark" aria-labelledby="nf-title">
    <DarkBackdrop grid />
    <div class="container nf__inner">
      <p class="nf__code" aria-hidden="true">404</p>
      <h1 id="nf-title" class="nf__title">{t.title}</h1>
      <p class="nf__text">{t.text} <span class="text-gold">{en.brand.tagline}</span></p>
      <p class="nf__text nf__text--ar" lang="ar" dir="rtl">{ar.ui.notFound.title} — {ar.ui.notFound.text}</p>
      <div class="nf__actions">
        <Button href={en.R.home} variant="gold" size="lg">{t.home}</Button>
        <Button href={en.R.solutions} variant="navy-soft" size="lg">{en.home.hero.ctas[0].label}</Button>
        <Button href={ar.R.home} variant="navy-soft" size="lg" icon={false}><span lang="ar">{ar.ui.notFound.home}</span></Button>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .nf {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    display: grid;
    align-items: center;
    min-height: 100svh;
    padding: calc(var(--header-h) + 40px) 0 80px;
    background: linear-gradient(160deg, var(--color-navy-800) 0%, var(--color-navy-900) 55%, var(--color-navy-950) 100%);
    text-align: center;
  }
  .nf__inner { display: flex; flex-direction: column; align-items: center; }
  .nf__code { font-family: var(--font-display); font-size: clamp(5.5rem, 16vw, 10rem); font-weight: 800; line-height: 0.9; color: var(--color-gold-500); }
  .nf__title { margin-top: 16px; color: #fff; }
  .nf__text { margin-top: 16px; font-size: var(--fs-lead); color: var(--color-blue-300); }
  .nf__text--ar { margin-top: 8px; font-family: var(--font-arabic); }
  .nf__actions { display: flex; flex-wrap: wrap; justify-content: center; gap: 14px; margin-top: 32px; }
  .nf__actions [lang='ar'] { font-family: var(--font-arabic); }
</style>
